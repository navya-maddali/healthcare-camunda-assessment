<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aaseya.camunda</groupId>
    <artifactId>camunda-process-framework</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>framework-observability-starter</artifactId>
  <packaging>jar</packaging>

  <name>framework-observability-starter</name>
  <description>
    Spring Boot auto-configuration for structured metrics and distributed tracing.
    Wires Micrometer Prometheus export and OpenTelemetry tracing so consuming services
    emit signals without manual instrumentation setup.
  </description>

  <dependencies>

    <!-- Framework core — provides MdcKeys constants used by the MDC filter. -->
    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Actuator — health, info, metrics, and management endpoints. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Prometheus registry — exposes /actuator/prometheus for scraping. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- OTel tracing bridge — forwards Micrometer spans to an OTel collector. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>

    <!-- Spring Web — required at compile time for the servlet filter that injects
         trace-id headers into HTTP responses. Consumers control whether web is
         on the runtime classpath. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>

    <!-- Configuration metadata processor — generates spring-configuration-metadata.json
         so IDEs offer completion for framework.observability.* properties. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

</project>
