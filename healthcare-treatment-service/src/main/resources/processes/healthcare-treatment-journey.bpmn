<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_healthcare" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="aeb6083" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_DiagSystem" name="Diagnostic System Unavailable" errorCode="DIAGNOSTIC_SYSTEM_UNAVAILABLE" />
  <bpmn:message id="Message_VitalsAlert" name="VitalsAlert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=caseId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_Healthcare">
    <bpmn:participant id="Participant_Hospital" name="Hospital — Inpatient Treatment Journey" processRef="healthcare-treatment-journey" />
  </bpmn:collaboration>
  <bpmn:process id="healthcare-treatment-journey" name="Healthcare Treatment Journey" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Journey">
      <bpmn:lane id="Lane_Admissions" name="Patient &#38; Admissions">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registration</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI Services (Camunda Connector)">
        <bpmn:flowNodeRef>Task_HistorySummary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DischargeSummary</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Decision" name="Clinical Decisioning (DMN)">
        <bpmn:flowNodeRef>Task_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DischargeReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IncrementCounter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MaxAttempts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Diagnostics" name="Diagnostics &#38; Laboratory">
        <bpmn:flowNodeRef>SubProcess_Diagnostics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryError_Diag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Physician" name="Attending Physician">
        <bpmn:flowNodeRef>Task_TreatmentPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Consults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalatePhysician</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ErrEnd_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DischargeSignoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Specialists" name="Specialist Consultations">
        <bpmn:flowNodeRef>AdHoc_Consultations</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Nursing" name="Nursing &#38; Treatment Execution">
        <bpmn:flowNodeRef>SubProcess_Treatment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="Senior Clinical Review">
        <bpmn:flowNodeRef>Task_ClinDirectorReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Records" name="Hospital Records">
        <bpmn:flowNodeRef>Task_Archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Patient Admitted">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Registration" name="Registration and Consent">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="registration-desk" />
        <zeebe:formDefinition formId="registration-form" />
        <!--
          No ioMapping on purpose. Declaring output mappings makes Zeebe propagate ONLY the
          mapped targets out of the task scope and discard every other completion variable.
          This task previously mapped just `businessKey`, so all eight registration-form fields
          (patientId, patientName, caseId, admissionType, chiefComplaint, vitalsSeverity,
          consentObtained, allergiesNotes) died with the task scope. The AI history step then
          resolved `patientName` to null, FEEL returned null for the whole concatenation and
          OpenAI rejected the request with "expected a string, got null".
          With no mapping every form field propagates to the process scope, and the tasks that
          needed `businessKey` now derive it locally from caseId.
        -->
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_HistorySummary" name="Summarize History (AI)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="2" />
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={historySummary: body.choices[1].message.content}" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.OPENAI_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://api.openai.com/v1/chat/completions" target="url" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={model: &#34;gpt-4o-mini&#34;, temperature: 0.2, messages: [{role: &#34;system&#34;, content: &#34;You are a clinical documentation assistant. Produce a concise, factual prior-history summary of at most 80 words. State only what the input supports; never invent findings.&#34;}, {role: &#34;user&#34;, content: &#34;Patient &#34; + patientName + &#34; (ID &#34; + patientId + &#34;) was admitted via &#34; + admissionType + &#34; with chief complaint &#34; + chiefComplaint + &#34;. Summarise relevant prior history, known allergies and clinical status on admission.&#34;}]}" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Triage" name="Triage and Care Pathway">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-care-pathway" resultVariable="triageResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=triageResult.carePlan" target="carePlan" />
          <zeebe:output source="=triageResult.diagnosticTests" target="diagnosticTests" />
          <zeebe:output source="=triageResult.priority" target="priority" />
          <zeebe:output source="=triageResult.assignedWard" target="assignedWard" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:subProcess id="SubProcess_Diagnostics" name="Parallel Diagnostics">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=patientId" target="patientId" />
          <zeebe:input source="=caseId" target="caseId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=diagnosticTests" inputElement="testType" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="SubDiag_Start">
        <bpmn:outgoing>SubFlow_D1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_CardioCheck" name="Cardiology workup?">
        <bpmn:incoming>SubFlow_D1</bpmn:incoming>
        <bpmn:outgoing>SubFlow_IsCardio</bpmn:outgoing>
        <bpmn:outgoing>SubFlow_IsLab</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_CardiologyWorkup" name="Cardiology Workup">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="diagnostics-technician" />
          <zeebe:formDefinition formId="cardiology-workup-form" />
        </bpmn:extensionElements>
        <bpmn:incoming>SubFlow_IsCardio</bpmn:incoming>
        <bpmn:outgoing>SubFlow_CardioJoin</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_OrderTest" name="Order Lab Test">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="lab-test-ordering" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=patientId" target="patientId" />
            <zeebe:input source="=testType" target="testType" />
            <zeebe:input source="=caseId" target="caseId" />
            <zeebe:input source="=caseId + &#34;-&#34; + testType" target="businessKey" />
            <zeebe:input source="=if (diagnosticSystemDown = null) then false else diagnosticSystemDown" target="diagnosticSystemDown" />
            <zeebe:output source="=orderId" target="orderId" />
            <zeebe:output source="=testStatus" target="testStatus" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>SubFlow_IsLab</bpmn:incoming>
        <bpmn:outgoing>SubFlow_ToIngest</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_IngestResult" name="Ingest Test Result">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="lab-result-ingestion" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=orderId" target="orderId" />
            <zeebe:input source="=testType" target="testType" />
            <zeebe:input source="=caseId" target="caseId" />
            <zeebe:input source="=caseId + &#34;-result-&#34; + testType" target="businessKey" />
            <zeebe:input source="=if (analyserSystemDown = null) then false else analyserSystemDown" target="analyserSystemDown" />
            <zeebe:output source="=testResult" target="testResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>SubFlow_ToIngest</bpmn:incoming>
        <bpmn:outgoing>SubFlow_LabJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <!--
        Compensation for a booked order. Not on a sequence flow: the engine invokes the handler
        only when compensation is thrown, once per branch that completed its order.
      -->
      <bpmn:boundaryEvent id="BoundaryCompensation_Order" name="Order placed" attachedToRef="Task_OrderTest">
        <bpmn:compensateEventDefinition id="CompensateDef_Order" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_CancelOrder" name="Cancel Lab Order" isForCompensation="true">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="lab-order-cancellation" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=orderId" target="orderId" />
            <zeebe:input source="=testType" target="testType" />
            <zeebe:input source="=caseId" target="caseId" />
            <zeebe:input source="=caseId + &#34;-cancel-&#34; + testType" target="businessKey" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_DiagJoin">
        <bpmn:incoming>SubFlow_CardioJoin</bpmn:incoming>
        <bpmn:incoming>SubFlow_LabJoin</bpmn:incoming>
        <bpmn:outgoing>SubFlow_DiagEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SubDiag_End">
        <bpmn:incoming>SubFlow_DiagEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubFlow_D1" sourceRef="SubDiag_Start" targetRef="Gateway_CardioCheck" />
      <bpmn:sequenceFlow id="SubFlow_IsCardio" name="Cardiology" sourceRef="Gateway_CardioCheck" targetRef="Task_CardiologyWorkup">
        <bpmn:conditionExpression>=testType = "CARDIOLOGY_WORKUP"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SubFlow_IsLab" name="Lab / Imaging" sourceRef="Gateway_CardioCheck" targetRef="Task_OrderTest">
        <bpmn:conditionExpression>=testType != "CARDIOLOGY_WORKUP"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SubFlow_CardioJoin" sourceRef="Task_CardiologyWorkup" targetRef="Gateway_DiagJoin" />
      <bpmn:sequenceFlow id="SubFlow_ToIngest" sourceRef="Task_OrderTest" targetRef="Task_IngestResult" />
      <bpmn:sequenceFlow id="SubFlow_LabJoin" sourceRef="Task_IngestResult" targetRef="Gateway_DiagJoin" />
      <bpmn:sequenceFlow id="SubFlow_DiagEnd" sourceRef="Gateway_DiagJoin" targetRef="SubDiag_End" />
      <!--
        Compensation has to be thrown from the scope that owns the completed activity. Catching the
        analyser failure here — rather than letting it reach the boundary event on the sub-process —
        keeps this branch alive long enough to unwind it: Task_OrderTest has completed in this scope,
        so its handler is still subscribed. Throwing from the parent instead does nothing, because an
        interrupted sub-process never completed and takes its handlers down with it.

        The error end event then re-raises the same error so the outer boundary still escalates.
      -->
      <bpmn:boundaryEvent id="BoundaryError_Ingest" name="Analyser Down" attachedToRef="Task_IngestResult">
        <bpmn:outgoing>SubFlow_ErrIngest</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrDef_Ingest" errorRef="Error_DiagSystem" />
      </bpmn:boundaryEvent>
      <bpmn:intermediateThrowEvent id="Throw_CompensateBranch" name="Cancel this order">
        <bpmn:incoming>SubFlow_ErrIngest</bpmn:incoming>
        <bpmn:outgoing>SubFlow_ToErrEnd</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="CompensateDef_Branch" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="ErrEnd_Branch" name="Diagnostics Failed">
        <bpmn:incoming>SubFlow_ToErrEnd</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrDef_BranchEnd" errorRef="Error_DiagSystem" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubFlow_ErrIngest" sourceRef="BoundaryError_Ingest" targetRef="Throw_CompensateBranch" />
      <bpmn:sequenceFlow id="SubFlow_ToErrEnd" sourceRef="Throw_CompensateBranch" targetRef="ErrEnd_Branch" />
      <!-- Artifacts must follow every flow element; the schema enforces that ordering. -->
      <bpmn:association id="Assoc_CompensateOrder" associationDirection="One" sourceRef="BoundaryCompensation_Order" targetRef="Task_CancelOrder" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryError_Diag" name="System Down" attachedToRef="SubProcess_Diagnostics">
      <bpmn:outgoing>Flow_Err1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_1" errorRef="Error_DiagSystem" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_EscalatePhysician" name="Escalate to Physician">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="attending-physician" />
        <zeebe:formDefinition formId="physician-escalation-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Err1</bpmn:incoming>
      <bpmn:outgoing>Flow_Err2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ErrEnd_1" name="Escalation End">
      <bpmn:incoming>Flow_Err2</bpmn:incoming>
    </bpmn:endEvent>
    <!--
      Escalation is reached with the booking already unwound: compensation runs inside the
      diagnostics sub-process, before the error propagates here.
    -->
    <bpmn:sequenceFlow id="Flow_Err1" sourceRef="BoundaryError_Diag" targetRef="Task_EscalatePhysician" />
    <bpmn:sequenceFlow id="Flow_Err2" sourceRef="Task_EscalatePhysician" targetRef="ErrEnd_1" />
    <bpmn:userTask id="Task_TreatmentPlan" name="Define Treatment Plan">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="attending-physician" />
        <zeebe:formDefinition formId="treatment-plan-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_TryAgain</bpmn:incoming>
      <bpmn:incoming>Flow_ClinDir_Back</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Consults" name="Consults needed?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_7_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:adHocSubProcess id="AdHoc_Consultations" name="Specialist Consultations" ordering="Parallel" cancelRemainingInstances="false">
      <bpmn:incoming>Flow_7_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:userTask id="Task_NeurologyConsult" name="Neurology Consult">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="neuro-specialist" />
          <zeebe:formDefinition formId="specialist-consult-form" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Task_EndoConsult" name="Endocrinology Consult">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="endo-specialist" />
          <zeebe:formDefinition formId="specialist-consult-form" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Task_PhysioConsult" name="Physiotherapy Consult">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="physio-specialist" />
          <zeebe:formDefinition formId="specialist-consult-form" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=consultsComplete = true</bpmn:completionCondition>
    </bpmn:adHocSubProcess>
    <bpmn:subProcess id="SubProcess_Treatment" name="Treatment Execution">
      <bpmn:incoming>Flow_7_No</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:startEvent id="SubTreat_Start">
        <bpmn:outgoing>SubTreat_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_TreatmentAdmin" name="Treatment Administration">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="nurse" />
          <zeebe:formDefinition formId="treatment-admin-form" />
        </bpmn:extensionElements>
        <bpmn:incoming>SubTreat_F1</bpmn:incoming>
        <bpmn:outgoing>SubTreat_F2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_VitalsMonitor" name="Monitor Vitals">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="vitals-monitoring" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=patientId" target="patientId" />
            <zeebe:input source="=caseId" target="caseId" />
            <zeebe:input source="=caseId + &#34;-vitals-&#34; + string(if dischargeAttemptCount = null then 0 else dischargeAttemptCount)" target="businessKey" />
            <zeebe:output source="=vitalsTrend" target="vitalsTrend" />
            <zeebe:output source="=vitalsAlertRaised" target="vitalsAlertRaised" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>SubTreat_F2</bpmn:incoming>
        <bpmn:outgoing>SubTreat_F3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SubTreat_End">
        <bpmn:incoming>SubTreat_F3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="EventSubProcess_VitalsAlert" name="Vitals Alert Handler" triggeredByEvent="true">
        <bpmn:startEvent id="MsgStart_VitalsAlert" name="Vitals Alert" isInterrupting="false">
          <bpmn:outgoing>VitalsAlert_F1</bpmn:outgoing>
          <bpmn:messageEventDefinition id="MsgDef_Vitals" messageRef="Message_VitalsAlert" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="Task_HandleAlert" name="Handle Vitals Alert">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="vitals-alert-handler" retries="1" />
            <zeebe:ioMapping>
              <zeebe:input source="=alertMessage" target="alertMessage" />
              <zeebe:input source="=vitalsTrend" target="vitalsTrend" />
              <!-- Derived locally now that Task_Registration no longer publishes businessKey. -->
              <zeebe:input source="=caseId" target="businessKey" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>VitalsAlert_F1</bpmn:incoming>
          <bpmn:outgoing>VitalsAlert_F2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="VitalsAlert_End">
          <bpmn:incoming>VitalsAlert_F2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="VitalsAlert_F1" sourceRef="MsgStart_VitalsAlert" targetRef="Task_HandleAlert" />
        <bpmn:sequenceFlow id="VitalsAlert_F2" sourceRef="Task_HandleAlert" targetRef="VitalsAlert_End" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="SubTreat_F1" sourceRef="SubTreat_Start" targetRef="Task_TreatmentAdmin" />
      <bpmn:sequenceFlow id="SubTreat_F2" sourceRef="Task_TreatmentAdmin" targetRef="Task_VitalsMonitor" />
      <bpmn:sequenceFlow id="SubTreat_F3" sourceRef="Task_VitalsMonitor" targetRef="SubTreat_End" />
    </bpmn:subProcess>
    <bpmn:businessRuleTask id="Task_DischargeReady" name="Check Discharge Readiness">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="discharge-readiness" resultVariable="dischargeResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <!--
      Flow_NotReady is the default flow. The discharge decision uses hit policy UNIQUE, so an input
      combination no rule covers yields no result at all rather than a false one — and then neither
      condition here evaluates to true and the instance raises a CONDITION_ERROR incident. Defaulting
      to "not ready" routes that case to the attempt counter instead, which retries and escalates to
      the Clinical Director after three passes.

      Defaulting towards "not discharged" is the safe direction: an indeterminate decision should
      never be the reason a patient is released.
    -->
    <bpmn:exclusiveGateway id="Gateway_Ready" name="Ready for discharge?" default="Flow_NotReady">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadyYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_IncrementCounter" name="Increment Attempt Count">
      <bpmn:extensionElements>
        <zeebe:script expression="=if dischargeAttemptCount = null then 1 else dischargeAttemptCount + 1" resultVariable="dischargeAttemptCount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotReady</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckMax</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_MaxAttempts" name="Over 3 attempts?">
      <bpmn:incoming>Flow_CheckMax</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate</bpmn:outgoing>
      <bpmn:outgoing>Flow_TryAgain</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ClinDirectorReview" name="Clinical Director Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="clinical-director" />
        <zeebe:formDefinition formId="clinical-director-form" />
        <!--
          The mapping must stay here, because resetting the counter to 0 is what terminates the
          escalate -> revise -> escalate loop. But a mapping also suppresses every unmapped
          completion variable, so the director's own form fields have to be listed explicitly or
          they are discarded exactly as the registration fields were.
          `=treatmentPlan` is safe unguarded: it resolves to the revised value when the form
          submits one and otherwise falls back to the physician's existing process-scope value.
          The two free-text fields are guarded because an unsubmitted variable raises an incident.
        -->
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="dischargeAttemptCount" />
          <zeebe:output source="=treatmentPlan" target="treatmentPlan" />
          <zeebe:output source="=if directorDecision = null then &#34;&#34; else directorDecision" target="directorDecision" />
          <zeebe:output source="=if directorNotes = null then &#34;&#34; else directorNotes" target="directorNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Escalate</bpmn:incoming>
      <bpmn:outgoing>Flow_ClinDir_Back</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_DischargeSummary" name="Draft Discharge Summary (AI)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="2" />
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={dischargeSummary: body.choices[1].message.content}" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.OPENAI_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://api.openai.com/v1/chat/completions" target="url" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={model: &#34;gpt-4o-mini&#34;, temperature: 0.2, messages: [{role: &#34;system&#34;, content: &#34;You are a clinical documentation assistant. Draft a discharge summary followed by a HOME CARE section as short bullet points. Be factual and use only the supplied details.&#34;}, {role: &#34;user&#34;, content: &#34;Patient: &#34; + patientName + &#34;. Care plan: &#34; + carePlan + &#34;. Treatment administered: &#34; + treatmentPlan + &#34;. Final vitals trend: &#34; + vitalsTrend + &#34;. Admission history: &#34; + historySummary + &#34;.&#34;}]}" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReadyYes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DischargeSignoff" name="Discharge Sign-off">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="attending-physician" />
        <zeebe:formDefinition formId="discharge-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Archive" name="Save to Database">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-archiving" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId" />
          <zeebe:input source="=patientId" target="patientId" />
          <zeebe:input source="=patientName" target="patientName" />
          <zeebe:input source="=carePlan" target="carePlan" />
          <zeebe:input source="=treatmentPlan" target="treatmentPlan" />
          <zeebe:input source="=dischargeSummary" target="dischargeSummary" />
          <zeebe:input source="=vitalsTrend" target="vitalsTrend" />
          <!-- Derived locally now that Task_Registration no longer publishes businessKey. -->
          <zeebe:input source="=caseId" target="businessKey" />
          <zeebe:output source="=archiveReferenceId" target="archiveReferenceId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Patient Discharged">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Registration" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Registration" targetRef="Task_HistorySummary" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_HistorySummary" targetRef="Task_Triage" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Triage" targetRef="SubProcess_Diagnostics" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="SubProcess_Diagnostics" targetRef="Task_TreatmentPlan" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_TreatmentPlan" targetRef="Gateway_Consults" />
    <bpmn:sequenceFlow id="Flow_7_Yes" name="Yes" sourceRef="Gateway_Consults" targetRef="AdHoc_Consultations">
      <bpmn:conditionExpression>=consultsRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7_No" name="No" sourceRef="Gateway_Consults" targetRef="SubProcess_Treatment">
      <bpmn:conditionExpression>=consultsRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="AdHoc_Consultations" targetRef="SubProcess_Treatment" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="SubProcess_Treatment" targetRef="Task_DischargeReady" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DischargeReady" targetRef="Gateway_Ready" />
    <bpmn:sequenceFlow id="Flow_ReadyYes" name="Ready" sourceRef="Gateway_Ready" targetRef="Task_DischargeSummary">
      <bpmn:conditionExpression>=dischargeResult.dischargeReady = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Default flow: carries both "the decision said no" and "the decision said nothing". -->
    <bpmn:sequenceFlow id="Flow_NotReady" name="Not ready" sourceRef="Gateway_Ready" targetRef="Task_IncrementCounter" />
    <bpmn:sequenceFlow id="Flow_CheckMax" sourceRef="Task_IncrementCounter" targetRef="Gateway_MaxAttempts" />
    <bpmn:sequenceFlow id="Flow_Escalate" name="Over 3 attempts" sourceRef="Gateway_MaxAttempts" targetRef="Task_ClinDirectorReview">
      <bpmn:conditionExpression>=dischargeAttemptCount &gt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TryAgain" name="Try again" sourceRef="Gateway_MaxAttempts" targetRef="Task_TreatmentPlan">
      <bpmn:conditionExpression>=dischargeAttemptCount &lt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ClinDir_Back" sourceRef="Task_ClinDirectorReview" targetRef="Task_TreatmentPlan" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_DischargeSummary" targetRef="Task_DischargeSignoff" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_DischargeSignoff" targetRef="Task_Archive" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Archive" targetRef="EndEvent_1" />
  </bpmn:process>
