# Build output
target/
*.class

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
Thumbs.db
.DS_Store
*.stackdump

# Secrets — never commit real local config; copy from the committed *.example instead.
#
# Camunda cluster credentials live in application-local.yml (profile `local`).
# Connector-secret exports downloaded from Camunda Console are named <clusterId>.env —
# `.env` alone does NOT match those, which is why the `*.env` glob is here.
**/application-local.yml
.env
*.env
!*.env.example
*.local.yml

# Scratch output from manual API calls. Never put these under src/main/resources —
# anything there is packaged into the jar.
*.log
scratch/

# Postman CLI working directories. It creates these wherever it is run, and nests them
# (postman/postman/postman/...) if run repeatedly from the same place.
postman/.postman/
postman/postman/
