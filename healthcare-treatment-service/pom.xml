<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent is the framework aggregator, resolved from the local repository
    (empty <relativePath/>), so this project lives outside the framework tree and
    never modifies it. Run `mvn install -DskipTests` in camunda-process-framework-0.1.1
    once before building this module.
  -->
  <parent>
    <groupId>com.aaseya.camunda</groupId>
    <artifactId>camunda-process-framework</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <groupId>com.aaseya.healthcare</groupId>
  <artifactId>healthcare-treatment-service</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>healthcare-treatment-service</name>
  <description>
    Use Case 2 — Healthcare Treatment Journey. Spring Boot 4.x job workers built on the
    Aaseya Camunda Process Framework, following its hexagonal layering. Contains the BPMN,
    DMN and Tasklist forms for the inpatient admission-to-discharge journey.
  </description>

  <dependencies>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Swagger UI + OpenAPI. The 3.x line is the one built for the Spring Boot 4 / Jakarta
      baseline the framework parent sets.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.0.1</version>
    </dependency>

    <!-- Framework starters — consumed as published artifacts; never edited. -->
    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-camunda-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!--
      Brings the framework's GlobalExceptionHandler, which already renders the framework
      exception types and bean-validation failures as RFC 7807. Our own advice only fills the
      gaps it leaves.
    -->
    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-web-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-data-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-observability-starter</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-core</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- PostgreSQL 17 JDBC driver — runtime only; version managed in the framework parent -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Flyway core + the Boot 4 autoconfiguration module. Boot 4 split autoconfigurations
      into separate artifacts; without spring-boot-flyway on the classpath
      FlywayAutoConfiguration is absent and migrations silently never run.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-process-test-spring</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The framework's ArchUnit rule set, plus the ArchUnit JUnit 5 runner. These enforce the
      layering this project's package structure exists to express — most importantly that
      io.camunda.client stays inside infrastructure.camunda.
    -->
    <dependency>
      <groupId>com.aaseya.camunda</groupId>
      <artifactId>framework-test</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.aaseya.healthcare.HealthcareTreatmentApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
